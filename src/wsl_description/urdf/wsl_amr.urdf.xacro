<?xml version="1.0"?>
<!--
  WSL warehouse AMR: Robotnik RB-Summit-XL Steel with four mecanum wheels, a 3D
  LiDAR on a mast, a forward RGB camera and an IMU. Visual meshes and their
  BSD-3-Clause licence are in meshes/rbsummit_steel/.

  base_footprint lies on the ground plane directly below the chassis centre,
  base_link is at axle height, so the robot rotates about the base_link z axis.
  All geometry follows REP-103 (x forward, y left, z up).

  Arguments only cover quantities that benchmark scenarios vary (sensor
  fidelity, odometry calibration error). Fixed geometry stays as properties.
-->
<robot name="wsl_amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="lidar_rate_hz" default="10"/>
  <xacro:arg name="lidar_channels" default="16"/>
  <xacro:arg name="lidar_horizontal_samples" default="900"/>
  <xacro:arg name="camera_rate_hz" default="20"/>
  <xacro:arg name="imu_rate_hz" default="100"/>
  <!--
    Ratio between the wheel geometry the drive assumes and the true geometry.
    1.0 is a perfectly calibrated robot. Values != 1 reproduce the systematic
    odometry errors (Borenstein's E_d / E_b) seen on real robots.
  -->
  <xacro:arg name="odom_wheel_radius_scale" default="1.0"/>
  <xacro:arg name="odom_wheel_separation_scale" default="1.0"/>
  <xacro:arg name="ground_truth" default="true"/>

  <xacro:include filename="$(find wsl_description)/urdf/inertial.xacro"/>

  <xacro:property name="mesh_dir" value="package://wsl_description/meshes/rbsummit_steel"/>

  <!-- Radius and width are the wheel mesh bounding box. -->
  <xacro:property name="wheel_radius" value="0.127"/>
  <xacro:property name="wheel_width" value="0.099"/>
  <xacro:property name="wheel_base" value="0.445"/>
  <xacro:property name="wheel_separation" value="0.409"/>
  <xacro:property name="wheel_mass" value="6.5"/>

  <!-- Chassis mesh bounding box, relative to base_link (which sits at axle height). -->
  <xacro:property name="chassis_length" value="0.719"/>
  <xacro:property name="chassis_width" value="0.57862"/>
  <xacro:property name="chassis_bottom_z" value="-0.06098"/>
  <xacro:property name="chassis_top_z" value="0.38212"/>
  <xacro:property name="chassis_height" value="${chassis_top_z - chassis_bottom_z}"/>
  <xacro:property name="chassis_z" value="${(chassis_top_z + chassis_bottom_z) / 2}"/>
  <!-- 125 kg in total before sensors. Mast mass is folded into the chassis box. -->
  <xacro:property name="chassis_mass" value="${125.0 - 4 * wheel_mass}"/>

  <!--
    The cover mesh is 1.5 mm thick and upstream sits flush in a recess of the
    chassis. It rests on the recess rim here instead, 3 mm above the recess
    floor, which is more than the depth buffer resolves at overview distances.
  -->
  <xacro:property name="top_cover_z" value="${chassis_top_z}"/>
  <xacro:property name="top_cover_top_z" value="${top_cover_z + 0.0015}"/>

  <!--
    The lowest ring (-15 deg) must pass over the far chassis corner, r = 0.462 m
    from the body centre, which takes 0.124 m above the chassis top. The sensor
    is on the centre so that this margin is the same in every direction.
  -->
  <xacro:property name="lidar_x" value="0.0"/>
  <xacro:property name="lidar_height_above_ground" value="0.66"/>
  <xacro:property name="lidar_z" value="${lidar_height_above_ground - wheel_radius}"/>
  <xacro:property name="lidar_radius" value="0.05"/>
  <xacro:property name="lidar_length" value="0.07"/>
  <xacro:property name="lidar_mass" value="0.8"/>
  <xacro:property name="mast_radius" value="0.025"/>
  <xacro:property name="mast_length" value="${lidar_z - lidar_length/2 - top_cover_top_z}"/>

  <!-- On the front face of the upper shell, 1 mm clear of the mesh. -->
  <xacro:property name="camera_x" value="${chassis_length/2 + 0.016}"/>
  <xacro:property name="camera_z" value="0.29"/>

  <!-- Colours from the Robotnik datasheet photo. Wheels use the mesh's own materials. -->
  <material name="chassis_black"><color rgba="0.14 0.14 0.15 1.0"/></material>
  <material name="cover_anthracite"><color rgba="0.28 0.28 0.30 1.0"/></material>
  <material name="dark_grey"><color rgba="0.35 0.35 0.35 1.0"/></material>
  <material name="sensor_black"><color rgba="0.10 0.10 0.10 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual name="chassis">
      <geometry><mesh filename="${mesh_dir}/rbsummit_steel_chassis.stl"/></geometry>
      <material name="chassis_black"/>
    </visual>
    <collision name="chassis">
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>

    <visual name="top_cover">
      <origin xyz="0 0 ${top_cover_z}"/>
      <geometry><mesh filename="${mesh_dir}/rbsummit_steel_top_cover.stl"/></geometry>
      <material name="cover_anthracite"/>
    </visual>

    <visual name="mast">
      <origin xyz="${lidar_x} 0 ${top_cover_top_z + mast_length/2}"/>
      <geometry><cylinder radius="${mast_radius}" length="${mast_length}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision name="mast">
      <origin xyz="${lidar_x} 0 ${top_cover_top_z + mast_length/2}"/>
      <geometry><cylinder radius="${mast_radius}" length="${mast_length}"/></geometry>
    </collision>

    <xacro:box_inertial mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="0 0 ${chassis_z}"/>
    </xacro:box_inertial>
  </link>

  <!--
    All wheel axes point along +y: positive joint velocity rolls the wheel
    towards +x. Rollers on the ground run along (1, -1) on mesh 1 and (1, 1) on
    mesh 2, which is the direction that carries traction: see fdir1 in the
    Gazebo file.
  -->
  <xacro:macro name="mecanum_wheel" params="name x y mesh">
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="50" velocity="25"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>
    <link name="${name}_wheel_link">
      <visual>
        <geometry><mesh filename="${mesh_dir}/kairos_mecanum_wheel_${mesh}.dae"/></geometry>
      </visual>
      <!--
        A sphere touches the floor directly below the axle. A cylinder's contact
        points sit off the axle, which made the robot turn at 1.13 rad/s when
        commanded 1.00 and put the odometry 44 deg off per revolution.
      -->
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin rpy="${pi/2} 0 0"/>
      </xacro:cylinder_inertial>
    </link>
  </xacro:macro>
  <xacro:mecanum_wheel name="front_left" x="${wheel_base/2}" y="${wheel_separation/2}" mesh="1"/>
  <xacro:mecanum_wheel name="front_right" x="${wheel_base/2}" y="${-wheel_separation/2}" mesh="2"/>
  <xacro:mecanum_wheel name="back_left" x="${-wheel_base/2}" y="${wheel_separation/2}" mesh="2"/>
  <xacro:mecanum_wheel name="back_right" x="${-wheel_base/2}" y="${-wheel_separation/2}" mesh="1"/>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}"/>
  </joint>
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
    </collision>
    <xacro:cylinder_inertial mass="${lidar_mass}" radius="${lidar_radius}" length="${lidar_length}">
      <origin/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z}"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.10 0.03"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <xacro:box_inertial mass="0.1" x="0.03" y="0.10" z="0.03">
      <origin/>
    </xacro:box_inertial>
  </link>

  <!-- REP-103 optical convention: z forward, x right, y down. -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_optical_frame"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${chassis_z}"/>
  </joint>
  <link name="imu_link"/>

  <xacro:include filename="$(find wsl_description)/urdf/wsl_amr.gazebo.xacro"/>

</robot>
